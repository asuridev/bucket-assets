# Plantilla para levantar el compose dentro de DevX, donde lo unico que se puede exponer es
# HTTP y ademas por subpath de un host compartido:
#
#   https://devx-cardif04.staging.echonet/user/<usuario>/http/<puerto>/
#
# Copiala a deploy/.env.devx (ignorado por git), sustituye <usuario> y arranca con:
#
#   podman-compose -f deploy/docker-compose.yaml --env-file deploy/.env.devx up -d
#
# En el panel PORTS de DevX hay que "Add Port" el 8081 para que la UI tenga forwarded address.

# URL publica de la consola de MinIO (puerto 9001). SIN barra final.
MINIO_PUBLIC_URL=https://devx-cardif04.staging.echonet/user/<usuario>/http/9001

# Prefijo bajo el que se sirve la UI de Redis. En devx-cardif04 va VACIO: el proxy recorta
# /user/<usuario>/http/8081 y al contenedor le llega "/", asi que la UI tiene que servir en la
# raiz. Sin valor, ni siquiera "/". Si le pones el prefijo, responde
# "Unauthorized - Missing Token". Se mantiene la variable por si otro entorno lo reenvia.
REDIS_UI_BASE_PATH=


# CAMBIALOS. En DevX esta URL es alcanzable y detras hay una consola con acceso total a la cache.
REDIS_UI_USER=
REDIS_UI_PASSWORD=
