target/

.idea/
*.iml
!.vscode/tasks.json
*.log

# Entorno real de DevX: lleva credenciales de la UI de Redis. La plantilla si viaja.
deploy/.env.devx

# Entorno real de DevX del stack de Mongo: lleva credenciales.
deploy-mongo/.env.devx

# Stack a la carta de infra/: entorno y ficheros generados.
infra/.env
infra/generated/
infra/conf/mongo-ui.conf
# El secreto del stub lo genera up.sh con las credenciales de MinIO de ESTE stack.
# La plantilla (secret-kv.json.template) si viaja.
infra/conf/secrets-manager-stub/mappings/secret-kv.json

# El service credential de Redis del stub: lo genera up.sh y lleva dentro la CA del TLS de
# ESTE stack, que tampoco se commitea. La plantilla si viaja.
infra/conf/secrets-manager-stub/mappings/secret-redis.json

# Certificados del Redis con TLS de infra/: los genera up.sh en cada entorno.
infra/conf/redis-tls/

# Valores propios para el stub de Secrets Manager (credenciales reales para probar en local)
deploy/secrets-manager-stub/mappings/*.local.json

# Credenciales reales descargadas de IBM Cloud: no viajan al repo.
service-credentials/
